<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - D'KAIZA Salón de Belleza</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-spa"></i> D'KAIZA
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Servicios" asp-action="Index">Servicios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contacto">Contacto</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">
                                <i class="fas fa-user-circle"></i> Iniciar Sesión
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER D'KAIZA -->
    <footer class="footer-dkaiza">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4 mb-md-0">
                    <div class="footer-brand">
                        <i class="fas fa-spa"></i> D'KAIZA
                    </div>
                    <p class="footer-description">
                        Transformando tu belleza con los mejores tratamientos y profesionales 
                        en un ambiente acogedor y relajante.
                    </p>
                    <div class="social-links">
                        <a href="#" class="social-link"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-whatsapp"></i></a>
                        <a href="#" class="social-link"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>

                <div class="col-md-2 mb-4 mb-md-0">
                    <h5 class="footer-title">Enlaces Rápidos</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Servicios" asp-action="Index">Servicios</a></li>
                        <li><a asp-controller="Home" asp-action="Nosotros">Nosotros</a></li>
                        <li><a asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                    </ul>
                </div>

                <div class="col-md-3 mb-4 mb-md-0">
                    <h5 class="footer-title">Horario de Atención</h5>
                    <ul class="footer-hours">
                        <li><span>Lunes - Viernes:</span> 9:00 AM - 8:00 PM</li>
                        <li><span>Sábados:</span> 9:00 AM - 6:00 PM</li>
                        <li><span>Domingos:</span> 10:00 AM - 4:00 PM</li>
                        <li class="closed"><span>Días festivos:</span> Consultar disponibilidad</li>
                    </ul>
                </div>

                <div class="col-md-3">
                    <h5 class="footer-title">Contáctanos</h5>
                    <ul class="footer-contact">
                        <li>
                            <i class="fas fa-map-marker-alt"></i>
                            <span>Av. Principal #123, Col. Centro<br>Ciudad, País</span>
                        </li>
                        <li>
                            <i class="fas fa-phone"></i>
                            <span>+52 123 456 7890</span>
                        </li>
                        <li>
                            <i class="fab fa-whatsapp"></i>
                            <span>+52 123 456 7890</span>
                        </li>
                        <li>
                            <i class="fas fa-envelope"></i>
                            <span>info@dkaiza.com</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row">
                    <div class="col-md-6 text-center text-md-start">
                        <p>&copy; @DateTime.Now.Year D'KAIZA Salón de Belleza. Todos los derechos reservados.</p>
                    </div>
                    <div class="col-md-6 text-center text-md-end">
                        <a asp-controller="Home" asp-action="PoliticaPrivacidad">Política de Privacidad</a> |
                        <a asp-controller="Home" asp-action="Terminos">Términos y Condiciones</a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>